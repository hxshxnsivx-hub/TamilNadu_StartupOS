# ── Vanigam backend environment (copy to .env; never commit .env) ──

# App
APP_ENV=development
APP_NAME=Vanigam
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# PostgreSQL (pgvector + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vanigam
POSTGRES_USER=vanigam
POSTGRES_PASSWORD=vanigam
# Async SQLAlchemy URL (built from the above if left blank)
DATABASE_URL=postgresql+asyncpg://vanigam:vanigam@localhost:5432/vanigam

# Redis (cache, sessions, semantic cache)
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO (encrypted document storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vanigam-documents
S3_REGION=us-east-1

# ── Managed-API providers (swappable adapters) ──
# LLM reasoning (orchestrator + swarms)
LLM_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_MAIN=claude-sonnet-5
LLM_MODEL_ROUTER=claude-haiku-4-5-20251001

# ── Free models for the mentor (app/agents/providers.py) ──
# Tried in this order; a failure or a used-up free quota moves to the next;
# templates are the last resort. Anthropic is skipped while its key is empty.
LLM_ORDER=anthropic,gemini,ollama
# Google Gemini API, free tier: create a key at https://aistudio.google.com/apikey
# (no payment). The same key gives the mentor's voice (Gemini text-to-speech).
# On the free tier Google may use the text to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE_EN=Sadaltager
GEMINI_TTS_VOICE_HI=Sadaltager
GEMINI_TTS_VOICE_TA=Sulafat
# Ollama on this machine: the offline backup (ollama pull gemma3:4b). Empty = off.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Translation (en/ta/hi) — Sarvam primary
TRANSLATION_PROVIDER=sarvam      # sarvam | google | indictrans2(self-host later)
SARVAM_API_KEY=                  # also the mentor's voice and listening on /talk

# Mentor voice (Sarvam): one speaker for Tamil, English and Hindi keeps the voice the same
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_PACE=0.95
SARVAM_STT_MODEL=saaras:v4

# Embeddings (multilingual, 1024-dim)
EMBEDDING_PROVIDER=cohere        # cohere | openai | bge-m3(self-host later)
COHERE_API_KEY=
EMBEDDING_DIM=1024

# Verification (Phase 2) — KYC aggregator + DigiLocker
VERIFICATION_PROVIDER=surepass   # surepass | sandbox | setu
VERIFICATION_API_KEY=

# Rate limits
RATE_LIMIT_PER_USER_PER_MIN=100
RATE_LIMIT_GLOBAL_PER_MIN=1000

# Prior-art research (optional; sources without keys are reported as not searched)
OPENALEX_API_KEY=
# Patents, worldwide with Indian filings: register free at https://developers.epo.org
# (create an app; fair use up to 4 GB a week). Preferred over PatentsView when set.
EPO_OPS_KEY=
EPO_OPS_SECRET=
# US patents only (free key); used when the EPO keys are empty.
PATENTSVIEW_API_KEY=
GITHUB_TOKEN=

# Ideation conversations: database | memory | auto (database if migrated, else memory)
AGENT_STORE=auto

# Requests per research source per UTC day (0: no cap); counted in Redis when it runs
RESEARCH_DAILY_LIMIT=0

# Review-panel seats run on this model; the conversation uses LLM_MODEL_MAIN
LLM_MODEL_FAST=claude-haiku-4-5-20251001
# Model tokens per conversation (0: no cap); past it the panel runs on rules
SESSION_TOKEN_BUDGET=0
